{
  "manifest_version": 3,
  "name": "Docs Image Copy as PNG",
  "version": "1.0.9",
  "description": "Copy Google Docs images as PNGs for pasting into websites, email, design tools, chat apps, and other destinations.",
  "homepage_url": "https://mlegkovskis.github.io/docs-image-copy-as-png/",
  "permissions": [
    "clipboardRead",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Convert copied Google Docs image to PNG",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Convert the last copied Google Docs image to PNG"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ]
}
